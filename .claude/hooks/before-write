#!/usr/bin/env bash
# before-write: PreToolUse hook for Write, Edit and MultiEdit (see .claude/settings.json).
# Usage: the harness runs  bash "$CLAUDE_PROJECT_DIR/.claude/hooks/before-write"  with the hook
#   JSON on stdin. It reads tool_input.file_path, resolved against CLAUDE_PROJECT_DIR (else the
#   current directory). Windows paths (backslashes, drive letters) are accepted.
#   - corrections.md, roster.confirmed.md or notes.md at any depth, or anything under <project>/house/:
#     refuses the write (exit 2, reason on stderr). Second layer under the deny rules.
#   - matter.md, facts.md or subject.md that exists: copies it first to
#     history/<stem>.<YYYY-MM-DD_HHMMSS>.md (-2 on a clash), with tools/history-copy when present.
#   - Anything else: exit 0, silent.
# Exit: 0 go ahead; 2 refused. Unreadable input or a failed copy never blocks: warning, exit 0.
# Needs bash 3.2+ and coreutils. JSON is read with python3/python/py, else jq, else sed.
# What this enforces: RULES.md, Protections. Without hooks: RULES.md, Harness notes.

export LC_ALL=C
export PYTHONIOENCODING=utf-8 PYTHONDONTWRITEBYTECODE=1
HOOK=before-write

# ---- shared block: identical in before-write and after-write ---------------------------------

warn() { printf '%s: warning: %s\n' "$HOOK" "$*" >&2; }

lower() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }

PY=""
for cand in python3 python "py -3"; do
  # shellcheck disable=SC2086
  if command -v "${cand%% *}" >/dev/null 2>&1 &&
     $cand -c 'import sys; sys.exit(0 if sys.version_info[0] >= 3 else 1)' >/dev/null 2>&1; then
    PY="$cand"
    break
  fi
done

hook_input="$(cat 2>/dev/null)"

# Print tool_input.file_path from the hook JSON. Return 1 when it cannot be read.
extract_path() {
  local out rc flat trimmed
  if [ -n "$PY" ]; then
    # shellcheck disable=SC2086
    out="$(printf '%s' "$hook_input" | $PY -c '
import json, sys
try:
    data = json.loads(sys.stdin.buffer.read().decode("utf-8", "replace"))
except Exception:
    sys.exit(3)
ti = data.get("tool_input") if isinstance(data, dict) else None
fp = ti.get("file_path") if isinstance(ti, dict) else None
if not isinstance(fp, str):
    sys.exit(3)
sys.stdout.buffer.write(fp.encode("utf-8"))
' 2>/dev/null)"
    rc=$?
    [ $rc -eq 0 ] && { printf '%s' "$out"; return 0; }
    [ $rc -eq 3 ] && return 1
    # Python itself failed: try jq, then sed.
  fi
  if command -v jq >/dev/null 2>&1; then
    out="$(printf '%s' "$hook_input" | jq -je '.tool_input.file_path | strings' 2>/dev/null)" &&
      { printf '%s' "$out"; return 0; }
    return 1
  fi
  # sed fallback: the input must look like one whole JSON object.
  flat="$(printf '%s' "$hook_input" | tr -d '\r\n')"
  trimmed="${flat#"${flat%%[![:space:]]*}"}"
  trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
  case "$trimmed" in "{"*"}") ;; *) return 1 ;; esac
  out="$(printf '%s' "$flat" | grep -o -E '"file_path"[[:space:]]*:[[:space:]]*"([^"\\]|\\.)*"' | head -n 1)"
  [ -n "$out" ] || return 1
  out="${out#*:}"
  out="${out#"${out%%[![:space:]]*}"}"
  out="${out#\"}"
  out="${out%\"}"
  out="${out//\\\\/$'\001'}"
  out="${out//\\\"/\"}"
  out="${out//\\\//\/}"
  out="${out//$'\001'/\\}"
  printf '%s' "$out"
}

# Windows forms to POSIX: backslashes to slashes, C:/x and /cygdrive/c/x to /c/x.
to_posix() {
  local p="$1" d
  p="${p//\\//}"
  case "$p" in
    [A-Za-z]: | [A-Za-z]:/*) d="$(lower "${p:0:1}")"; p="/$d${p:2}" ;;
    /cygdrive/[A-Za-z] | /cygdrive/[A-Za-z]/*) d="$(lower "${p:10:1}")"; p="/$d${p:11}" ;;
  esac
  printf '%s' "$p"
}

# Absolute path without . and .. segments; $2 is the base for a relative path.
canon() {
  local p="$1" lead="" part out="" IFS
  case "$p" in /*) ;; *) p="$2/$p" ;; esac
  case "$p" in //[!/]*) lead="/" ;; esac
  IFS=/
  set -f
  for part in $p; do
    case "$part" in
      '' | .) ;;
      ..) out="${out%/*}" ;;
      *) out="$out/$part" ;;
    esac
  done
  set +f
  printf '%s' "$lead${out:-/}"
}

# Path of $1 relative to directory $2, compared without case. Return 1 when outside.
rel_to() {
  local p_lc b_lc
  p_lc="$(lower "$1")"
  b_lc="$(lower "$2")"
  case "$p_lc" in
    "$b_lc"/*) printf '%s' "${1:$((${#2} + 1))}"; return 0 ;;
  esac
  return 1
}

# $1 with symlinks resolved, best effort. Prints nothing when it cannot.
resolve() {
  local p="$1" dir base target n=0
  while :; do
    dir="${p%/*}"
    base="${p##*/}"
    [ -n "$dir" ] || dir="/"
    dir="$(cd "$dir" 2>/dev/null && pwd -P)" || return 0
    dir="$(to_posix "$dir")"
    p="${dir%/}/$base"
    [ -L "$p" ] || break
    n=$((n + 1))
    [ $n -le 16 ] || return 0
    target="$(readlink "$p" 2>/dev/null)" || return 0
    target="$(to_posix "$target")"
    case "$target" in /*) p="$target" ;; *) p="${dir%/}/$target" ;; esac
    p="$(canon "$p" /)"
  done
  printf '%s' "$p"
}

# Newest history/<stem>.<YYYY-MM-DD_HHMMSS>[-N].md of $1, as common.latest_history picks it.
latest_history() {
  local f="$1" dir name stem ext c rest stamp n key best="" bestkey=""
  dir="${f%/*}"
  name="${f##*/}"
  stem="${name%.*}"
  ext=".${name##*.}"
  [ -d "$dir/history" ] || return 0
  for c in "$dir/history/$stem".*"$ext"; do
    [ -f "$c" ] || continue
    rest="${c##*/}"
    rest="${rest#"$stem".}"
    rest="${rest%"$ext"}"
    stamp="${rest:0:17}"
    n="${rest:17}"
    case "$stamp" in
      [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]) ;;
      *) continue ;;
    esac
    case "$n" in
      '') n=1 ;;
      -*) n="${n#-}"; case "$n" in '' | *[!0-9]*) continue ;; esac ;;
      *) continue ;;
    esac
    key="${stamp//[-_]/}$(printf '%012d' "$((10#$n))")"
    if [ -z "$bestkey" ] || [[ "$key" > "$bestkey" ]]; then
      best="$c"
      bestkey="$key"
    fi
  done
  printf '%s' "$best"
}

if ! raw="$(extract_path)" || [ -z "$raw" ]; then
  warn "could not read tool_input.file_path from the hook input; nothing checked."
  exit 0
fi
proj_raw="${CLAUDE_PROJECT_DIR:-$PWD}"
proj="$(canon "$(to_posix "$proj_raw")" "$(to_posix "$PWD")")"
proj="${proj%/}"
abs="$(canon "$(to_posix "$raw")" "${proj:-/}")"
rel="$(rel_to "$abs" "$proj")" || rel="$abs"
base_lc="$(lower "${abs##*/}")"

# ---- end of shared block -----------------------------------------------------------------------

# Human-only: corrections.md, roster.confirmed.md, notes.md, <project>/house/, any matter's human/ folder. Checked on the path as given
# and on the path with symlinks resolved.
is_human_only() {
  local r
  case "$(lower "${1##*/}")" in corrections.md | roster.confirmed.md | notes.md) return 0 ;; esac
  if r="$(rel_to "$1" "$2")"; then
    case "$(lower "$r")" in house | house/* | areas/*/human/*) return 0 ;; esac
  fi
  return 1
}

refuse=no
if is_human_only "$abs" "$proj"; then
  refuse=yes
else
  real_abs="$(resolve "$abs")"
  real_proj="$(resolve "${proj:-/}")"
  if [ -n "$real_abs" ] && [ -n "$real_proj" ] && is_human_only "$real_abs" "${real_proj%/}"; then
    refuse=yes
    shown="$(rel_to "$real_abs" "${real_proj%/}")" && rel="$shown"
  fi
fi
if [ "$refuse" = yes ]; then
  printf 'Refused: %s is human-only (RULES.md, Protections). Tell the human what to write instead.\n' "$rel" >&2
  exit 2
fi

# Same naming as tools/history-copy and common.history_copy. Prints the copy's path.
copy_to_history() {
  local f="$1" dir name stem ext stamp dest n=2
  dir="${f%/*}"
  name="${f##*/}"
  stem="${name%.*}"
  ext=".${name##*.}"
  mkdir -p "$dir/history" 2>/dev/null || return 1
  stamp="$(date +%Y-%m-%d_%H%M%S)" || return 1
  dest="$dir/history/$stem.$stamp$ext"
  while [ -e "$dest" ]; do
    dest="$dir/history/$stem.$stamp-$n$ext"
    n=$((n + 1))
  done
  cp -p "$f" "$dest" 2>/dev/null || cp "$f" "$dest" 2>/dev/null || return 1
  printf '%s' "$dest"
}

case "$base_lc" in
  matter.md | facts.md | subject.md)
    [ -f "$abs" ] || exit 0
    copied=no
    if [ -f "$proj/tools/history-copy" ]; then
      before="$(latest_history "$abs")"
      if (cd "${proj:-/}" && bash "$proj/tools/history-copy" "$abs") >/dev/null 2>&1; then
        after="$(latest_history "$abs")"
        [ -n "$after" ] && [ "$after" != "$before" ] && copied=yes
      fi
    fi
    if [ "$copied" = no ] && ! copy_to_history "$abs" >/dev/null; then
      warn "could not copy $rel to history/. Copy it by hand before rewriting it (RULES.md, Protections)."
    fi
    ;;
esac
exit 0
