# What git keeps and what it never keeps.
# The repository is the workspace template plus the invented demo.
# A live workspace's data (emails, matters, knowledge, indexes, logs) is never committed.

# Live data folders: keep only the empty folders (.gitkeep) and knowledge/TYPES.md.
# house/ holds your filled-in house files: never in git (the blank ones are in templates/house/).
/house/*
!/house/.gitkeep

/areas/*
!/areas/.gitkeep

/inbox/**
!/inbox/**/
!/inbox/**/.gitkeep

/knowledge/**
!/knowledge/**/
!/knowledge/**/.gitkeep
!/knowledge/TYPES.md

/seeds/**
!/seeds/**/
!/seeds/**/.gitkeep
/learning/**
!/learning/**/
!/learning/**/.gitkeep

/digests/*
!/digests/.gitkeep

/changes/*
!/changes/.gitkeep

# Legal skills drafted with the lawyer hold your organisation's positions: never in git.
# Only the operational skills, POINTERS.md and their generated mirror are kept.
/skills/*
!/skills/operations/
!/skills/POINTERS.md
/.claude/skills/*
!/.claude/skills/.generated
!/.claude/skills/budget/
!/.claude/skills/bundle/
!/.claude/skills/checkpoint/
!/.claude/skills/close/
!/.claude/skills/cold-start/
!/.claude/skills/draft-skill/
!/.claude/skills/index/
!/.claude/skills/intake/
!/.claude/skills/intake-reading/
!/.claude/skills/interview/
!/.claude/skills/learn/
!/.claude/skills/matter-memory/
!/.claude/skills/note/
!/.claude/skills/reply/
!/.claude/skills/status/

# Files a live workspace generates at its root.
/MANIFEST.csv
/INDEX.csv
/INDEX.md
/JOURNAL.md
/WORKFLOW-LOG.md
/BUDGET.md
/TOOLING.md
/DASHBOARD.html
*.new.csv

# A demo workspace created inside the repository.
/demo/workspace*/

# Build output and local environments.
node_modules/
/demo/build/**/out/
.venv*/
__pycache__/
*.pyc
.pytest_cache/

# Per-user Claude Code settings. The shared settings are .claude/settings.json.
/.claude/settings.local.json

# Operating system and editor junk.
.DS_Store
Thumbs.db
desktop.ini
~$*
*.tmp
.~lock*
*.swp
