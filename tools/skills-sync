#!/usr/bin/env bash
# skills-sync: mirror the canonical skills in skills/ to .claude/skills/ (generated, never edited by hand).
# Usage: bash tools/skills-sync [--check]
#   (no option)  mirror every skills/<group>/<name>/ holding SKILL.md to .claude/skills/<name>/, replacing it whole;
#                remove mirror folders with no canonical skill; write .claude/skills/.generated
#   --check      compare only, write nothing; exit 1 on any difference (slice 4 check)
# Groups: operations, or an area key from house/areas.md (other groups are mirrored with a warning).
# Two groups with a skill of the same name: name clash, nothing written, exit 2.
# Pure bash: find, cmp, cp. Edit skills/, then run this; never edit .claude/skills/.
# Exit: 0 ok, 1 findings or check failed, 2 usage error or name clash.
# Fallback without this script: copy each skills/<group>/<name>/ folder to .claude/skills/<name>/ by hand and write the .generated marker.
FALLBACK="copy each skills/<group>/<name>/ folder to .claude/skills/<name>/ by hand, delete mirror folders with no canonical skill, write .claude/skills/.generated."
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "${1:-}" in -h|--help) sed -n '2,/^FALLBACK=/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//'; exit 0;; esac
set -u

CHECK=0
skip=0
for arg in "$@"; do
  [ "$skip" = 1 ] && { skip=0; continue; }
  case "$arg" in
    --check) CHECK=1 ;;
    --run) skip=1 ;;            # accepted like every tool; not used
    --run=*) ;;
    *) echo "skills-sync: unknown argument: $arg" >&2
       echo "Usage: bash tools/skills-sync [--check]" >&2
       exit 2 ;;
  esac
done

ROOT="${INTAKE_ROOT:-$here/..}"
ROOT="$(cd "$ROOT" 2>/dev/null && pwd -P)" || { echo "skills-sync: workspace not found: ${INTAKE_ROOT:-$here/..}" >&2; exit 2; }
SRC="$ROOT/skills"
DST="$ROOT/.claude/skills"
MARKER_TEXT="Generated by tools/skills-sync from skills/. Do not edit."

if [ ! -d "$SRC" ]; then
  echo "skills-sync: no skills/ folder in $ROOT" >&2
  exit 1
fi

# Canonical skills, one "name<TAB>group" line each, sorted by name.
LIST="$(
  for d in "$SRC"/*/*/; do
    [ -f "${d}SKILL.md" ] || continue
    d="${d%/}"
    name="${d##*/}"
    group="${d%/*}"
    group="${group##*/}"
    printf '%s\t%s\n' "$name" "$group"
  done | LC_ALL=C sort
)"

# Name clash between groups: refuse before writing anything.
DUPS="$(printf '%s\n' "$LIST" | cut -f1 | LC_ALL=C uniq -d)"
if [ -n "$DUPS" ]; then
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    groups="$(printf '%s\n' "$LIST" | awk -F '\t' -v n="$n" '$1 == n { printf "%sskills/%s/%s", sep, $2, n; sep = " and " }')"
    echo "skills-sync: name clash: $groups both mirror to .claude/skills/$n; rename one" >&2
  done <<< "$DUPS"
  exit 2
fi

# Groups should be operations or an area key.
AREA_KEYS=""
if [ -f "$ROOT/house/areas.md" ]; then
  AREA_KEYS="$(sed -n 's/^##[[:space:]][[:space:]]*\([a-z0-9][a-z0-9-]*\)[[:space:]]*$/\1/p' "$ROOT/house/areas.md")"
  for g in $(printf '%s\n' "$LIST" | cut -f2 | LC_ALL=C sort -u); do
    [ "$g" = "operations" ] && continue
    printf '%s\n' "$AREA_KEYS" | grep -qxF "$g" || \
      echo "warning: skills/$g/ is neither operations nor an area key in house/areas.md; mirrored anyway"
  done
fi

# File list of a tree, relative, OS junk left out.
tree_files() {
  (cd "$1" && find . -type f ! -name .DS_Store ! -name Thumbs.db ! -name desktop.ini | LC_ALL=C sort)
}

# 0 when both trees hold the same files with the same bytes.
same_tree() {
  [ -d "$2" ] || return 1
  local a b f
  a="$(tree_files "$1")"
  b="$(tree_files "$2")"
  [ "$a" = "$b" ] || return 1
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    cmp -s "$1/$f" "$2/$f" || return 1
  done <<< "$a"
  return 0
}

COUNT=0
DIFFS=0
UPDATED=""
REMOVED=""
while IFS="$(printf '\t')" read -r name group; do
  [ -n "$name" ] || continue
  COUNT=$((COUNT + 1))
  src="$SRC/$group/$name"
  dst="$DST/$name"
  same_tree "$src" "$dst" && continue
  if [ "$CHECK" = 1 ]; then
    if [ -e "$dst" ]; then
      echo "differs: .claude/skills/$name (canonical: skills/$group/$name)"
    else
      echo "missing: .claude/skills/$name (canonical: skills/$group/$name)"
    fi
    DIFFS=$((DIFFS + 1))
  else
    mkdir -p "$DST"
    rm -rf "$dst"
    cp -R "$src" "$dst" || { echo "skills-sync: could not copy skills/$group/$name" >&2; exit 1; }
    UPDATED="$UPDATED${UPDATED:+, }$name"
  fi
done <<< "$LIST"

# Mirror folders with no canonical skill.
if [ -d "$DST" ]; then
  for d in "$DST"/*/; do
    [ -d "$d" ] || continue
    d="${d%/}"
    n="${d##*/}"
    printf '%s\n' "$LIST" | cut -f1 | grep -qxF "$n" && continue
    if [ "$CHECK" = 1 ]; then
      echo "extra: .claude/skills/$n (no canonical skill in skills/)"
      DIFFS=$((DIFFS + 1))
    else
      rm -rf "$d"
      REMOVED="$REMOVED${REMOVED:+, }$n"
    fi
  done
fi

if [ "$CHECK" = 1 ]; then
  if [ "$(cat "$DST/.generated" 2>/dev/null)" != "$MARKER_TEXT" ]; then
    echo "marker: .claude/skills/.generated is missing or changed"
    DIFFS=$((DIFFS + 1))
  fi
  if [ "$DIFFS" -gt 0 ]; then
    echo "skills-sync --check: $DIFFS difference(s) between skills/ and .claude/skills/; run bash tools/skills-sync"
    exit 1
  fi
  echo "skills-sync --check: .claude/skills/ matches skills/ ($COUNT skills)"
  exit 0
fi

mkdir -p "$DST"
printf '%s\n' "$MARKER_TEXT" > "$DST/.generated"
summary="skills-sync: $COUNT skills mirrored to .claude/skills/"
[ -n "$UPDATED" ] && summary="$summary; updated: $UPDATED"
[ -n "$REMOVED" ] && summary="$summary; removed: $REMOVED"
[ -z "$UPDATED$REMOVED" ] && summary="$summary; no changes"
echo "$summary"
exit 0
