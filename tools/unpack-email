#!/usr/bin/env bash
# unpack-email: headers, new body text, attachments and filing signals of .eml files.
# Usage: bash tools/unpack-email [--json] [--body-chars N] [--extract DIR] [--no-signals] FILE...
#   --json          JSON array, one object per file (default Markdown).
#   --body-chars N  body limit in characters, default 4000; a longer body ends "[... N more characters]".
#   --extract DIR   write document, image and email attachments to DIR/<canonical stem>/.
#   --no-signals    skip thread_matches, tag_matches and already_filed.
# Fields: file, canonical_name (YYYY-MM-DD_HHMM_<in|out>_<from-slug>_<subject-slug>.eml, house time),
#   direction (out = From in legal_addresses or intake_mailbox), internal, personal_address, date,
#   from, to, cc, subject, message_id, in_reply_to, references, tags, noise_hints, notes, sha256,
#   size, attachments {name, content_type, size, sha256, kind, inline}, body_chars_total,
#   quoted_chars, body (new text only), signals {thread_matches, tag_matches, already_filed}.
# kind: document | image | signature-image | calendar | email. sha256 is over the decoded bytes place-email stores.
# .eml only: a .msg exits 2 with "convert first: bash tools/msg2eml FILE". No side effects except --extract.
# Exit: 0 ok, 1 findings or check failed, 2 usage error, 3 Python missing (fallback printed).
# Fallback without Python: read the .eml as text (headers on top, body below); save attachments with munpack or ripmime; hash files with bash tools/hash-files.
FALLBACK="read the .eml as text (headers on top, body below); save attachments with munpack or ripmime; hash files with bash tools/hash-files."
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "${1:-}" in -h|--help) sed -n '2,/^FALLBACK=/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//'; exit 0;; esac
. "$here/lib/find-python.sh"
exec $PY "$here/lib/unpack_email.py" "$@"
